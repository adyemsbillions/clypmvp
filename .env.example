# Clyp Design Studio V5.2 — local development
CLYP_ENV=development
CLYP_APP_URL=http://127.0.0.1:8080
CLYP_AI_ENDPOINT=http://127.0.0.1:8100

# Keep this token private. Any long random value is fine for localhost.
CLYP_AI_INTERNAL_TOKEN=replace-with-a-long-random-local-token

# Gemini design reasoning
CLYP_GEMINI_API_KEY=replace-with-your-gemini-api-key
CLYP_GEMINI_MODEL=gemini-2.5-flash

# Optional image generation. If unavailable/quota-limited, Clyp falls back to Openverse.
CLYP_GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
CLYP_GEMINI_IMAGE_FALLBACK_MODEL=gemini-3.1-flash-lite-image
CLYP_STOCK_FALLBACK=1

# V5.2 design-completion guard
CLYP_AUTO_POLISH_SPARSE=1
CLYP_MIN_DESIGN_LAYERS=12
